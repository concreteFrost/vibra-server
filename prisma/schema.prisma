generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  username String
  email    String @unique
  passHash String

  tracks        Track[]
  playlists     Playlist[]
  // artists       Artist[]
  trackLikes    TrackLike[]
  trackComments TrackComment[]

  createdAt DateTime @default(now())
}

model Track {
  id       String         @id @default(uuid())
  title    String
  fileKey  String
  likes    TrackLike[]
  comments TrackComment[]

  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId String
  artistName String @default("")

  playlists PlaylistTrack[]
  // artist   Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  // artistId String?

  createdAt DateTime @default(now())
}

// model Artist {
//   id   String @id @default(uuid())
//   name String

//   createdBy User?   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
//   creatorId String?

//   tracks Track[]

//   createdAt DateTime @default(now())
// }

model TrackLike {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId String

  createdAt DateTime @default(now())

  @@unique([userId, trackId])
}

model TrackComment {
  id      String @id @default(uuid())
  content String

  commentedBy User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId String

  createdAt DateTime @default(now())
}

model Playlist {
  id     String          @id @default(uuid())
  title  String
  tracks PlaylistTrack[]
  owner  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model PlaylistTrack {
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId String

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String

  @@unique([playlistId, trackId])
}
